# Telegram Bot Token from BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Comma-separated list of allowed Telegram user IDs
ALLOWED_USER_IDS=123456789

# Path for audit logs (defaults to ~/Library/Application Support/telecode/logs)
LOG_PATH=

# Claude model to use (leave empty to use Claude Code's default)
CLAUDE_MODEL=

# Session timeout in milliseconds (defaults to 1800000 = 30 minutes)
SESSION_TIMEOUT_MS=1800000

# Maximum number of concurrent sessions (1-10, defaults to 5)
MAX_SESSIONS=5

# Path for session persistence file (defaults to ~/Library/Application Support/telecode/sessions.json)
SESSIONS_FILE_PATH=

# Path for bookmarks file (defaults to ~/Library/Application Support/telecode/bookmarks.json)
BOOKMARKS_FILE_PATH=
