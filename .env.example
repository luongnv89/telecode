# Telegram Bot Token from BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Comma-separated list of allowed Telegram user IDs
ALLOWED_USER_IDS=123456789

# Directory for audit logs (defaults to ~/Library/Application Support/telecode/logs)
LOG_PATH=

# Claude model to use (leave empty to use Claude Code's default)
CLAUDE_MODEL=

# Session timeout in milliseconds (defaults to 86400000 = 1 day)
SESSION_TIMEOUT_MS=86400000

# Maximum number of concurrent sessions (1-10, defaults to 5)
MAX_SESSIONS=5

# Path for session persistence file (defaults to ~/Library/Application Support/telecode/sessions.json)
SESSIONS_FILE_PATH=

# Path for bookmarks file (defaults to ~/Library/Application Support/telecode/bookmarks.json)
BOOKMARKS_FILE_PATH=

# Absolute path to workspace directory for /launch. Default: $HOME
WORKSPACE=

# Comma-separated allowed tools: claude, opencode, codex
ALLOWED_TOOLS=claude

# Default AI backend: "claude", "opencode", or "codex" (defaults to claude)
DEFAULT_BACKEND=claude

# OpenCode server URL (defaults to http://localhost:4096)
# Only used when backend is "opencode"
OPENCODE_BASE_URL=

# Model for OpenCode sessions (e.g., anthropic/claude-sonnet-4-20250514)
OPENCODE_MODEL=
