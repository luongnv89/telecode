{
  "name": "telecode",
  "version": "0.1.0",
  "description": "Telegram bot that wraps Claude Code for remote macOS control",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "telecode": "dist/cli.js"
  },
  "license": "MIT",
  "author": "Luong Nguyen",
  "repository": {
    "type": "git",
    "url": "https://github.com/luongnv89/telecode.git"
  },
  "bugs": {
    "url": "https://github.com/luongnv89/telecode/issues"
  },
  "homepage": "https://github.com/luongnv89/telecode#readme",
  "keywords": [
    "telegram",
    "bot",
    "claude",
    "claude-code",
    "ai",
    "remote-control",
    "macos",
    "developer-tools"
  ],
  "scripts": {
    "build": "tsc",
    "postbuild": "chmod +x dist/cli.js",
    "dev": "tsx src/index.ts",
    "dev:cli": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.1.0",
    "@anthropic-ai/sdk": "^0.39.0",
    "@opencode-ai/sdk": "^1.2.6",
    "dotenv": "^16.4.0",
    "grammy": "^1.35.0",
    "uuid": "^11.1.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
